# Copy to .env.local for local runs. On Vercel, set the same names under
# Project -> Settings -> Environment Variables. Without any of these the bot
# still works end to end with the buttons; typed questions then get a
# "call us" fallback and no e-mail goes out.

# --- AI (only used for typed messages): openai | gemini ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- E-mail (Resend) ---
RESEND_API_KEY=
LEAD_EMAIL_TO=info@banacraft.hu
# Needs a verified Resend domain for real sending; defaults to Resend's test sender.
LEAD_EMAIL_FROM=

# --- Optional ---
# Zoho Flow incoming webhook (server-side only, never in public/).
ZOHO_FLOW_WEBHOOK_URL=
# Password for GET /api/faq-agent?selftest=<key>
OWNER_TEST_KEY=
# Comma-separated origins allowed to call the API, e.g. the Banacraft site.
ALLOWED_ORIGINS=
